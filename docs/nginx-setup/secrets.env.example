# Contabo VPS — MTAPI Nginx Secrets
# Copy this file to secrets.env and fill in the values.
# The setup.sh script will generate the API_KEY automatically if left blank.

# Domain for the MTAPI service (must match the DNS A record in Cloudflare)
MTAPI_DOMAIN=mtapi.tscopier.ai

# Port nginx listens on (external)
MTAPI_PORT=9443

# API key for authentication (64-char random string)
# Leave blank to have setup.sh generate one automatically
MTAPI_API_KEY=

# IP address of the Contabo VPS (used for SSH in README)
CONTABO_IP=
