# Railway worker peer — WireGuard client config for the MTAPI private tunnel.
#
# Copy this file to /etc/wireguard/wg0.conf on the worker host (or the peer
# container), replace the placeholders, then:
#   sudo wg-quick up wg0
#
# After the tunnel is up, set Railway env:
#   MTAPI_BASE_URL=http://10.66.0.1:9443
# Keep MTAPI_API_KEY and MTAPI_INTERNAL_TOKEN — the tunnel nginx block still
# checks the Bearer API key (defense in depth).
#
# Railway limitation: containers often have no kernel WireGuard module.
# If `wg-quick` fails with "Operation not supported", use userspace
# wireguard-go, or stay on the public HTTPS path (option D alone).

[Interface]
# Private key generated by deploy/wireguard/vps-setup.sh on the VPS
# (saved under /etc/wireguard/peers/railway-worker.private — never commit).
PrivateKey = REPLACE_WITH_PEER_PRIVATE_KEY
Address = 10.66.0.2/32

[Peer]
# Contabo VPS (mtapi.tscopier.ai)
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
PresharedKey = REPLACE_WITH_PRESHARED_KEY
Endpoint = REPLACE_WITH_VPS_PUBLIC_IP:51820
AllowedIPs = 10.66.0.1/32
PersistentKeepalive = 25
