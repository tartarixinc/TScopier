{
  "name": "project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:backoffice": "npm --prefix apps/backoffice run dev",
    "build:backoffice": "npm --prefix apps/backoffice run build",
    "dev:docs": "npm --prefix apps/docs run dev",
    "build:docs": "npm --prefix apps/docs run build",
    "lint": "eslint .",
    "migrations:check": "python3 scripts/check-migrations.py",
    "preview": "vite preview",
    "test": "bash scripts/run-frontend-tests.sh",
    "test:vitest": "vitest run $(grep -rl \"from 'vitest'\" src --include='*.test.ts' | paste -sd ' ' -)",
    "test:node": "node --import tsx --import ./test/preload.ts --test $(grep -rl \"from 'node:test'\" src --include='*.test.ts' | paste -sd ' ' -)",
    "test:account-type": "node --import tsx --import ./test/preload.ts --test src/lib/brokerFromServer.test.ts src/lib/brokerHealth.test.ts",
    "test:worker": "npm --prefix worker test",
    "deploy:function": "bash scripts/deploy-edge-function.sh",
    "upload:email-assets": "bash scripts/upload-email-assets.sh"
  },
  "dependencies": {
    "@livechat/widget-react": "^1.4.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@supabase/supabase-js": "^2.105.3",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
