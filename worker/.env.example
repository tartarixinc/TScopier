# Frontend (Vite) — required for local dev and Netlify builds.
# In Netlify: Site configuration → Environment variables → add these exact names.
# Values are baked in at build time; redeploy after changing them.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile (signup/login/forgot-password bot protection)
# Public site key — safe to commit. Set the same value on Netlify for prod/staging builds.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAENwYkTwFMwfAUdc
# Test keys for localhost-only dev without the real widget: site 1x00000000000000000000AA
# Optional — use direct Supabase host for Realtime WebSocket when a custom auth domain
# (e.g. sso.tscopier.ai) causes intermittent browser WebSocket failures:
# VITE_SUPABASE_REALTIME_URL=https://YOUR_PROJECT_REF.supabase.co

# Marketing vs app hostnames (baked at build time — see docs/marketing-site.md)
VITE_APP_URL=https://app.tscopier.ai
VITE_MARKETING_URL=https://tscopier.ai
# VITE_DEV_SITE=marketing   # local preview of landing on localhost

# Optional — Stripe Checkout is hosted on stripe.com (no frontend publishable key required).
# Set STRIPE_SECRET_KEY and price IDs on Supabase Edge Functions (see supabase secrets).

# Optional
# VITE_BACKTEST_ENABLED=true
# VITE_GA_MEASUREMENT_ID=G-6TQBY0FKX3

# Redis Streams queue (Upstash) — durable listener → trade dispatch (10k-ready)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# TRADE_SIGNAL_QUEUE_ENABLED=false
# TRADE_SIGNAL_QUEUE_ENTRY_STREAM=signals:entry
# TRADE_SIGNAL_QUEUE_MGMT_STREAM=signals:mgmt
# TRADE_SIGNAL_QUEUE_SHARD_COUNT=1
# Must match number of trade worker shards (use 1 for single trade worker).
# TRADE_SIGNAL_QUEUE_CONSUMER_CONCURRENCY=8
# Canary rollout: only these trade shards use queue (comma-separated). Omit for all shards.
# TRADE_SIGNAL_QUEUE_CANARY_SHARDS=0
# TRADE_SIGNAL_QUEUE_CONSUMER_BLOCK_MS=2000
# TRADE_SIGNAL_QUEUE_CLAIM_IDLE_MS=60000
# TRADE_SIGNAL_QUEUE_MAX_ATTEMPTS=5
# TRADE_SIGNAL_QUEUE_READ_COUNT=10
# TRADE_SIGNAL_QUEUE_RETRY_BASE_MS=250
# When queue enqueue fails, fall back to HTTP push (default true during cutover).
# TRADE_SIGNAL_PUSH_FALLBACK_ON_QUEUE_FAIL=true
# After stable queue SLO: set TRADE_SIGNAL_PUSH_ENABLED=false to disable HTTP push globally.
# Pre-warm /Symbols + /SymbolParams on trade worker start (default true).
# EXECUTOR_PREWARM_SYMBOLS=true
# Inline parse in listener (default true). false = edge parse-signal HTTP fallback.
# LISTENER_INLINE_PARSE=true
# Parse retries on transient failure (AI timeout/429/transport). 1 = no retry. Default 3.
# LISTENER_PARSE_MAX_ATTEMPTS=3
# gramjs listener only — set telethon on Python telegram-listener service instead.
# LISTENER_ENGINE=gramjs
# Trade HTTP dispatch: await OrderSend before ACK (default true on split deploy).
# TRADE_DISPATCH_AWAIT_DEFAULT=true
# Channel keywords/lexicon cache TTL for inline parse (ms). Default 300000 (5 min).
# CHANNEL_PARSE_CACHE_TTL_MS=300000
# OpenAI for modification/management messages (replies, move SL, message revisions).
# Stretched spellings (e.g. breakevennn, noowww) are normalized before deterministic parse.
# OPENAI_API_KEY is an optional fallback when deterministic parse misses or confidence is low.
# Required on the LISTENER worker (Railway WORKER_ROLE=listener) for AI-assisted revisions.
# Without it, structured entry edits still reconcile via deterministic re-parse.
# OPENAI_API_KEY=
# 3-stage signal verification (fastpath mode):
#   Stage 1 = deterministic regex engine (fast lane >= UNIVERSAL_PARSE_FASTPATH_CONFIDENCE).
#   Stage 2 = fast OSS LLM on Cerebras Inference (OpenAI-compatible). Falls back to OpenAI
#             when no Cerebras key is set or every key fails. Keys from cloud.cerebras.ai.
#   Stage 3 = GPT-4o reconciliation (Option 1) only when stage 2 is uncertain,
#             the hallucination guard rejects stage 2, or stage 2 blocks a trade
#             the deterministic parser found. OSS-confirmed and OSS-recovered
#             results (including SL/TP modifications) are trusted directly. Off by default.
# CEREBRAS_API_KEY_1=   # one env var per account (CEREBRAS_API_KEY_1, _2, _3, ...);
#                       # each message rotates to the next key (round-robin) so
#                       # daily token quotas are shared across accounts. A key that
#                       # hits "Tokens per day limit exceeded" is skipped for the
#                       # rest of the process; the next key is used.
# CEREBRAS_API_KEY_2=
# CEREBRAS_API_KEY=     # legacy single key, used only when no numbered keys are set
# CEREBRAS_PARSE_ENABLED=true
# CEREBRAS_PARSE_MODEL=gpt-oss-120b
# UNIVERSAL_PARSE_RECONCILE_ENABLED=false
# UNIVERSAL_PARSE_RECONCILE_MODEL=gpt-4o
# UNIVERSAL_PARSE_RECONCILE_TIMEOUT_MS=8000
# Human-review escalation: hold AI-uncertain signals for user approval within a
# 2-minute window (in-app modal + Telegram nudge + optional email).
# Deactivated by default — uncertain signals are skipped silently like any other
# non-actionable message. Set to true to activate the review prompts again.
# HUMAN_REVIEW_ESCALATION_ENABLED=false
# Re-fetch bare teaser entries (e.g. "Gold buy now") after channel adds SL/TP via edit.
# ENTRY_MESSAGE_SETTLE_MS=10000
# Multi-shot settle polls (ms, comma-separated). Default: ENTRY_MESSAGE_SETTLE_MS then 3x (max 30s).
# ENTRY_MESSAGE_SETTLE_DELAYS_MS=10000,30000
# Cron backup: WORKER_URL (or TELEGRAM_LISTENER_URL) + WORKER_INTERNAL_TOKEN on edge signal-reconcile-sweep
# AI_MODIFICATION_PARSE_ENABLED=true
# AI_MODIFICATION_PARSE_TIMEOUT_MS=3500
# AI_MODIFICATION_PARSE_MODEL=gpt-4o-mini
# OpenAI fallback when deterministic entry parse fails or produces implausible values (default true).
# Requires OPENAI_API_KEY on the same listener worker — without the key AI entry is skipped.
# AI_ENTRY_PARSE_ENABLED=true
# AI_ENTRY_PARSE_TIMEOUT_MS=4000
# AI_ENTRY_PARSE_MODEL=gpt-4o-mini
# Signal ↔ Telegram text reconciliation (edited messages).
# SIGNAL_RECONCILE_SWEEP_MS=60000
# SIGNAL_RECONCILE_WINDOW_MS=21600000
# SIGNAL_RECONCILE_MAX_SIGNALS=100
# SIGNAL_RECONCILE_POLL_HOOK_WINDOW_MS=7200000
# SIGNAL_RECONCILE_POLL_HOOK_MAX_SIGNALS=30
# Block live entry during news blackout before OrderSend (default false; post-fill audit only).
# EXECUTOR_NEWS_BLACKOUT_PRE_FILL=false
# Execution engine (default v1 if unset). Production: use global v2 for fast entries, closes, and SL/TP reconcile.
# EXECUTION_ENGINE=v2
# Static/Dynamic range-layering rollout controls. Defaults are fail-closed:
# Legacy is unaffected, Static/Dynamic require all gates plus an account allowlist.
# Keep these values synchronized on worker services and the layering Edge Functions
# (`layering-mode-capabilities`, `update-layering-settings`) so UI capability and
# worker execution decisions match.
# LAYERING_MODES_EXECUTION_ENABLED=false
# LAYERING_STATIC_EXECUTION_ENABLED=false
# LAYERING_DYNAMIC_EXECUTION_ENABLED=false
# LAYERING_MODES_ACCOUNT_ALLOWLIST=
# LAYERING_MODES_PREPARE_ONLY=true
# LAYERING_MODES_KILL_SWITCH=true
# Native pending reconciliation ownership lease (ms). Default 300000.
# LAYERING_NATIVE_RECOVERY_LEASE_TIMEOUT_MS=300000
# Staged cutover only (omit when EXECUTION_ENGINE=v2 is set):
# EXECUTION_ENGINE_V2_BROKERS=broker-account-uuid,other-uuid
# EXECUTION_ENGINE_V2_USERS=user-uuid
# v2 reconcile loop interval (ms). Default 4000. Only used when v2 is enabled (trade_mgmt / trade role).
# V2_RECONCILE_TICK_MS=4000

# Help menu (header) — external links open in a new tab
# VITE_HELP_DOCS_URL=https://docs.tscopier.ai
# VITE_HELP_LIVE_CHAT_URL=
# VITE_HELP_WHATSAPP_URL=https://wa.me/1234567890
# VITE_HELP_TELEGRAM_URL=https://t.me/your_support_channel
# VITE_HELP_STATUS_URL=https://status.tscopier.ai

# Supabase Edge Function secrets (set via `supabase secrets set`, not in .env):
# TURNSTILE_SECRET_KEY=        — Cloudflare Turnstile secret (verify tokens server-side)
# BEFORE_USER_CREATED_HOOK_SECRET= — Auth hook signing secret from Supabase dashboard
# SIGNUP_BLOCKED_EMAIL_PATTERNS= — optional comma-separated regexes for local-part blocking
# RESEND_API_KEY=              — required for signup confirmation + password reset emails
# EMAIL_LOGO_URL=              — optional override for logo img src in emails
# FMP_API_KEY=       — Market News + Economic Calendar

# MTAPI bridge (migration only — see docs/mtapi-credentials.md)
# MTAPI_BASE_URL=https://mtapi.tscopier.ai:9443
# MTAPI_API_KEY=  — Bearer key for nginx Authorization check
# Shared secret for X-Internal-Token header (replaces IP allowlist on nginx).
# Same value as Supabase Edge MTAPI_INTERNAL_TOKEN and /root/.mtapi_internal_token.
# MTAPI_INTERNAL_TOKEN=

# Bridge liveness probe (worker/src/observability/bridgeProbe.ts): pings the
# bridge health paths and writes system_probe_state/samples/events rows the
# admin Systems Health page and alert-evaluator read. Runs on shard 0 only.
# Default interval 30000ms (min 5000), per-URL timeout 5000ms (min 1000).
# BRIDGE_PROBE_INTERVAL_MS=30000
# BRIDGE_PROBE_TIMEOUT_MS=5000
# Restrict targets (comma list) if one bridge is intentionally absent:
# BRIDGE_PROBE_TARGETS=bridge_mt5,bridge_mt4

# How often pending accounts are picked up for bridge provisioning (ms, min 5000).
# The session health sweep stays separate and slow (default 240000).
# MTAPI_PROVISION_INTERVAL_MS=15000

# ── Sentry test flags (STAGING ONLY) ──────────────────────────────────────────
# These FORCE a failure so you can verify Sentry fires the matching alert. All
# default to OFF (false). Set to true to trigger, then set back to false to
# restore normal behavior.
#
# Email brand assets (public Storage bucket `email-assets`):
#   1. supabase db push   (migration 20260703120000_email_assets_storage_bucket.sql)
#   2. npm run upload:email-assets   (needs SUPABASE_SERVICE_ROLE_KEY in .env)
#   Public URL: {SUPABASE_URL}/storage/v1/object/public/email-assets/tscopierlogo.png

# FxSocket (Supabase Edge + worker) — see docs/fxsocket-integration.md
# FXSOCKET_API_KEY=fxs_live_...
# WORKER_PUBLIC_URL=https://your-worker.up.railway.app  — edge stream_ticket URLs

# MTAPI internal token (shared secret, replaces IP allowlist on nginx).
# Generate with: openssl rand -base64 48 | tr -d '=+/' | head -c 64
# Same value must be set on: Supabase Edge secrets, Railway worker env, and
# /root/.mtapi_internal_token on the VPS (nginx map $internal_ok).
# MTAPI_INTERNAL_TOKEN=
# MTAPI_API_KEY=  — Bearer key also checked by nginx (Authorization header)
# MTAPI_BASE_URL=https://mtapi.tscopier.ai:9443  — set via supabase secrets set

# Frontend WebSocket stream proxy (live dashboard metrics)
# VITE_WORKER_URL=https://your-worker.up.railway.app

# Worker (Railway / local worker/.env) — same FMP key for news-trading blackout filter:
# FMP_API_KEY=
# Discord gateway listener (npm run discord). One process only. Do not put this token in VITE_ vars.
# DISCORD_BOT_TOKEN=
# WhatsApp group listener (npm run whatsapp). One process per shard. Do not open the same account twice.
# WHATSAPP_LISTENER_PORT=8091
# Same Supabase project the app uses (the user's login). A different project rejects the token as unauthorized.
# WHATSAPP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# WHATSAPP_SUPABASE_SERVICE_ROLE_KEY=
# Authenticated dashboard community CTA (must be a full https://t.me/... URL)
# VITE_TELEGRAM_COMMUNITY_URL=https://t.me/your_community

# Force trade executions to fail so the system-wide trade-pipeline failure monitor
# can fire. Set to true to trigger, then set back to false to restore normal behavior.
# TRADE_PIPELINE_TEST_FORCE_FAILURE=false
# Failure-rate threshold (0-100) for the alert. Default 50.
# TRADE_PIPELINE_FAILURE_THRESHOLD_PCT=50
# Load-test workers must omit FXSOCKET_API_KEY and set both flags below.
# LOAD_TEST_MODE=true
# BROKER_SIMULATOR_MODE=true
# FXSOCKET_HTTP_CONNECTIONS=128
# Public worker URL for browser WebSocket streams (stream_ticket edge action)
# WORKER_PUBLIC_URL=https://your-worker.up.railway.app

# Internal HTTP server consumed by the supabase telegram-auth edge function
# Generate a long random string (e.g. `openssl rand -hex 32`).
# WORKER_URL must be the public Railway URL (https://your-app.up.railway.app) — scheme required for fetch; host-only is auto-fixed in telegram-auth.
WORKER_INTERNAL_TOKEN=replace-with-long-random-secret
WORKER_PORT=8080

# Multi-trade merge: set true to use legacy reply/thread linking for SL/TP posts (default false = latest open basket).
# WORKER_LEGACY_MERGE_LINKING=false
# Basket SL/TP refresh: rounds to wait for late trade rows/tickets before giving up (default 8; live mgmt fast path uses 2).
# BASKET_REFRESH_STRAGGLER_ROUNDS=8
# Inter-leg gap for sequential basket modifies (default 50ms; live mgmt fast path uses 0).
# BASKET_LEG_MODIFY_GAP_MS=50
# Management leg parallelism for CWE / close / SL modify on live Telegram path (default 6, max 12).
# MGMT_LEG_CONCURRENCY=6
# Max concurrent trade ops (OrderSend/Modify/Close) per broker account. An MT terminal
# executes orders serially; too many in-flight at one terminal makes the bridge time out.
# Default 3, capped at 8. Lower (2) if you still see "OrderModify timed out" under bursts.
# MT_PER_ACCOUNT_TRADE_CONCURRENCY=3
# Canonical channel SL apply (live mgmt + diagnostics). Default on; set false to use legacy path.
# MGMT_USE_CHANNEL_STOP_APPLY=true
# Post-close verify sleep ms on live fast tier (default 0); sweeps/reconcile keep 400ms poll.
# MGMT_CLOSE_VERIFY_MS=0
# Redis mgmt stream consumer block ms (default 150; was 500).
# TRADE_SIGNAL_QUEUE_MGMT_CONSUMER_BLOCK_MS=150
# Listener HTTP push timeout for mgmt signals (default 5000ms fallback when queue disabled).
# TRADE_SIGNAL_PUSH_TIMEOUT_MS=5000
# Basket reconcile monitor (failed merge retries): tick interval ms, max attempts, backoff base ms.
# BASKET_RECONCILE_TICK_MS=15000
# BASKET_RECONCILE_MAX_ATTEMPTS=48
# BASKET_RECONCILE_BACKOFF_MS=15000

# One-trade-per-TP bundling for multi-style accounts (design: docs/bundled-single-tp-trade-style.md).
# Unset/false = classic count-weighted multi split. true/1/yes = one broker position per
# enabled Targets % level (50/30/20), each with its own TP. Ignored for range/layering.
# TP_BUNDLE_ENABLED=true

# Backtest market data uses FXSOCKET_API_KEY on Supabase Edge (linked broker terminal).
# No separate market-data key is required on the worker.

# One-off diagnostics on Railway (run inside worker service shell after deploy):
#   npm run build
#   DRY_RUN=true SIGNAL_ID=<uuid> SINCE_ISO=2026-06-17T11:08:00Z npm run rebalance-open-baskets
#   DRY_RUN=true SIGNAL_ID=<uuid> SINCE_ISO=2026-06-17T11:08:00Z SL_ONLY=true npm run push-signal-stops
# Requires: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, FXSOCKET_API_KEY (omit DRY_RUN to execute).
