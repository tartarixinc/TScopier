# Frontend (Vite) — required for local dev and Netlify builds.
# In Netlify: Site configuration → Environment variables → add these exact names.
# Values are baked in at build time; redeploy after changing them.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile (signup/login/forgot-password bot protection)
# Public site key — safe to commit. Set the same value on Netlify for prod/staging builds.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAENwYkTwFMwfAUdc
# Test keys for localhost-only dev without the real widget: site 1x00000000000000000000AA
# Optional — use direct Supabase host for Realtime WebSocket when a custom auth domain
# (e.g. sso.tscopier.ai) causes intermittent browser WebSocket failures:
# VITE_SUPABASE_REALTIME_URL=https://YOUR_PROJECT_REF.supabase.co

# Marketing vs app hostnames (baked at build time — see docs/marketing-site.md)
VITE_APP_URL=https://app.tscopier.ai
VITE_MARKETING_URL=https://tscopier.ai
# VITE_DEV_SITE=marketing   # local preview of landing on localhost

# Optional — Stripe Checkout is hosted on stripe.com (no frontend publishable key required).
# Set STRIPE_SECRET_KEY and price IDs on Supabase Edge Functions (see supabase secrets).

# Optional
# VITE_BACKTEST_ENABLED=true
# VITE_GA_MEASUREMENT_ID=G-6TQBY0FKX3

# Help menu (header) — external links open in a new tab
# VITE_HELP_DOCS_URL=https://docs.tscopier.ai
# VITE_HELP_LIVE_CHAT_URL=
# VITE_HELP_WHATSAPP_URL=https://wa.me/1234567890
# VITE_HELP_TELEGRAM_URL=https://t.me/your_support_channel
# VITE_HELP_STATUS_URL=https://status.tscopier.ai

# Supabase Edge Function secrets (set via `supabase secrets set`, not in .env):
# TURNSTILE_SECRET_KEY=        — Cloudflare Turnstile secret (verify tokens server-side)
# BEFORE_USER_CREATED_HOOK_SECRET= — Auth hook signing secret from Supabase dashboard
# SIGNUP_BLOCKED_EMAIL_PATTERNS= — optional comma-separated regexes for local-part blocking
# RESEND_API_KEY=              — required for signup confirmation + password reset emails
# EMAIL_LOGO_URL=              — optional override for logo img src in emails
# FMP_API_KEY=       — Market News + Economic Calendar
#
# Email brand assets (public Storage bucket `email-assets`):
#   1. supabase db push   (migration 20260703120000_email_assets_storage_bucket.sql)
#   2. npm run upload:email-assets   (needs SUPABASE_SERVICE_ROLE_KEY in .env)
#   Public URL: {SUPABASE_URL}/storage/v1/object/public/email-assets/tscopierlogo.png

# FxSocket (Supabase Edge + worker) — see docs/fxsocket-integration.md
# FXSOCKET_API_KEY=fxs_live_...
# WORKER_PUBLIC_URL=https://your-worker.up.railway.app  — edge stream_ticket URLs

# MTAPI internal token (shared secret, replaces IP allowlist on nginx).
# Generate with: openssl rand -base64 48 | tr -d '=+/' | head -c 64
# Same value must be set on: Supabase Edge secrets, Railway worker env, and
# /root/.mtapi_internal_token on the VPS (nginx map $internal_ok).
# MTAPI_INTERNAL_TOKEN=
# MTAPI_API_KEY=  — Bearer key also checked by nginx (Authorization header)
# MTAPI_BASE_URL=https://mtapi.tscopier.ai:9443  — set via supabase secrets set

# Frontend WebSocket stream proxy (live dashboard metrics)
# VITE_WORKER_URL=https://your-worker.up.railway.app

# Worker (Railway / local worker/.env) — same FMP key for news-trading blackout filter:
# FMP_API_KEY=
